# ---------------------------------------------------------------------------
# Minik Diş — ortam değişkenleri
# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
# `.env.local` sürüm kontrolüne dahil edilmez (bkz. .gitignore).
# ---------------------------------------------------------------------------

# Sitenin yayındaki tam adresi. Şunlarda kullanılır:
# canonical etiket, Open Graph görselleri, sitemap.xml, robots.txt, JSON-LD.
# Örnek: https://www.minikdis.com
NEXT_PUBLIC_SITE_URL=

# Opsiyonel: randevu taleplerinin iletileceği webhook adresi.
# Slack / Zapier / n8n / kendi API'niz olabilir.
# Tanımlıysa her yeni talep buraya JSON olarak POST edilir.
# Örnek: https://hooks.zapier.com/hooks/catch/123456/abcdef/
APPOINTMENT_WEBHOOK_URL=
